# Copy to server/generate/.env (gitignored). Real process.env always wins over this file.
# Every key is optional; defaults below match server/generate/config.js.

# Google AI Studio key for the Gemini provider. Unset = provider unavailable.
GEMINI_API_KEY=

# Gemini image model id.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Codex CLI binary path. Unset = search PATH, then ~/.local/bin/codex.
CODEX_CLI_PATH=

# Optional Codex model override. Unset = CLI default.
CODEX_MODEL=

# Codex reasoning effort: minimal, low, medium, high, xhigh, max, or ultra.
CODEX_EFFORT=low

# OpenAI-compatible local image server, e.g. http://127.0.0.1:7744. Unset = provider unavailable.
LOCAL_IMAGE_URL=

# Model name to send to the local image server.
LOCAL_IMAGE_MODEL=

# Where the style profile (preamble + reference images) is stored. Relative paths resolve
# against the repository root.
GENERATE_DATA_DIR=data/generate
