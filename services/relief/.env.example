# GPU index or UUID from nvidia-smi. The default is the first GPU.
RELIEF_GPU=0
RELIEF_PORT=8766
# Optional: a URL to call when the GPU is out of memory, before one GPU retry.
# llama-swap example (unloads its models; they reload on their next request):
# RELIEF_FREE_GPU_URL=http://host.docker.internal:8080/unload
# Optional: unload the depth model after this many idle minutes. 0 keeps it loaded.
# RELIEF_IDLE_UNLOAD_MINUTES=10
# Optional absolute path for retained source images, raw depth and exports.
# RELIEF_DATA_PATH=/path/to/pieceout-relief/data
